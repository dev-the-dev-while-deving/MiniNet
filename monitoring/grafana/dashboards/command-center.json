{
  "uid": "fortress-command-center",
  "title": "Fortress-Net Command Center",
  "description": "Health, traffic and threat picture for the Fortress-Net lab (T23).",
  "tags": [
    "fortress-net"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Hosts in BREACH",
      "datasource": {
        "type": "prometheus",
        "uid": "fortress-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fortress-prometheus"
          },
          "editorMode": "code",
          "expr": "fortress_threat_hosts{band=\"breach\"}",
          "legendFormat": "breach",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
