# sshd_config for {{ node }} (T15). GENERATED by topology/render_configs.py (configs/ssh/sshd_config.j2).
# One sshd per node, inside its own namespace, with its own files (Mininet hosts share one
# filesystem, decisions D12). Started as: sshd -f this-file -E {{ log_dir }}/sshd.log
Port 22
ListenAddress {{ listen }}
HostKey {{ etc_dir }}/ssh_host_ed25519_key
PidFile {{ run_dir }}/sshd.pid
# Admins log in as "{{ user }}" with the lab's admin key (made at lab start, never committed).
AuthorizedKeysFile {{ authorized_keys }}
AllowUsers {{ user }}
PermitRootLogin no
PubkeyAuthentication yes
# Password logins stay enabled so brute-force attempts reach sshd and get logged (T20/T21),
# but they can never succeed: the "{{ user }}" account has no password.
PasswordAuthentication yes
KbdInteractiveAuthentication no
# UsePAM yes: with "no", sshd treats a locked account (no password, like ours) as invalid even
# for key logins. PAM still refuses every password, because the account has none.
UsePAM yes
LogLevel INFO
