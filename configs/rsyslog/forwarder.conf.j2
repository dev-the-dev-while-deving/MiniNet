# rsyslog.conf for {{ node }}: forwards this node's log files to {{ server }} (T15).
# GENERATED by topology/render_configs.py (configs/rsyslog/forwarder.conf.j2).
# Lab daemons log to files (decisions D12): imfile tails them, omfwd sends each line over the
# lab network to the central server. Mininet hosts share one hostname, so the node name is
# written into every message here.
global(workDirectory="{{ run_dir }}/rsyslog")
module(load="imfile")
{% for f in files %}
# freshStartTail: only send lines written from now on, not the whole history of earlier runs
# (that burst of thousands of old lines briefly swamped the Servers zone at start-up).
input(type="imfile" File="{{ f.path }}" Tag="{{ f.tag }}:" Severity="info" Facility="local0" freshStartTail="on")
{% endfor %}
template(name="Fwd" type="string" string="<%PRI%>%TIMESTAMP% {{ node }} %syslogtag%%msg%\n")
*.* action(type="omfwd" target="{{ server }}" port="514" protocol="udp" template="Fwd")
