# rsyslog.conf for {{ node }}: the central log server (T15).
# GENERATED by topology/render_configs.py (configs/rsyslog/server.conf.j2).
# Receives syslog over UDP 514 from every forwarder and writes one file per sending node.
# Only the modules we need: no imuxsock, so it never competes with the VM's own rsyslog for /dev/log.
global(workDirectory="{{ run_dir }}/rsyslog")
module(load="imudp")
input(type="imudp" address="{{ listen }}" port="514")
template(name="PerNode" type="string" string="{{ log_dir }}/remote/%HOSTNAME%.log")
template(name="Line" type="string" string="%TIMESTAMP:::date-rfc3339% %HOSTNAME% %syslogtag%%msg%\n")
*.* action(type="omfile" dynaFile="PerNode" template="Line" dirCreateMode="0755" fileCreateMode="0644")
