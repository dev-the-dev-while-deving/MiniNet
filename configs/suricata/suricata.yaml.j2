%YAML 1.1
---
# suricata.yaml for {{ node }} (T17). GENERATED by topology/render_configs.py.
# Runs on ids1, which has no IP: it only listens on mirror ports of the cores (decisions D13).
# Started as: suricata -c this-file --af-packet -D (one worker per mirror interface below).

# HOME_NET = everything inside the base; a scan "into" the base is traffic towards these.
vars:
  address-groups:
    HOME_NET: "[{{ home_net }}]"
    EXTERNAL_NET: "any"
  port-groups:
    HTTP_PORTS: "80"
    SSH_PORTS: "22"

default-log-dir: {{ log_dir }}

# One af-packet worker per mirror interface (ids1-eth0 on c1, ids1-eth1 on c2, decisions D13).
af-packet:
{% for intf in interfaces %}
  - interface: {{ intf }}
    cluster-id: {{ 98 + loop.index }}
    cluster-type: cluster_flow
    defrag: yes
    use-mmap: yes
{% endfor %}

# Only our own rules by default (detection/suricata/local.rules). update_suricata_rules.sh can
# drop an et-open.rules next to it, and it is picked up here if present.
default-rule-path: {{ rule_dir }}
rule-files:
  - local.rules
{% if et_open %}
  - et-open.rules
{% endif %}

classification-file: /etc/suricata/classification.config
reference-config-file: /etc/suricata/reference.config

outputs:
  # eve.json: one JSON object per event. The threat engine (T20) reads the "alert" events.
  - eve-log:
      enabled: yes
      filetype: regular
      filename: eve.json
      types:
        - alert:
            tagged-packets: yes
        - stats:
            totals: yes
  - stats:
      enabled: yes
      filename: stats.log
      interval: 10

logging:
  default-log-level: notice
  outputs:
    - file:
        enabled: yes
        level: info
        filename: {{ log_dir }}/suricata.log

# Mininet links are plain Ethernet; 802.1Q tags on the mirror are decoded by default.
vlan:
  use-for-tracking: true

app-layer:
  protocols:
    ssh:
      enabled: yes
    http:
      enabled: yes
    dns:
      enabled: yes
    tls:
      enabled: yes
