# iptables rules for {{ router }}, loaded with iptables-restore inside {{ router }}'s namespace.
# GENERATED from config/fortress.yaml by topology/render_configs.py (template configs/iptables/rules.j2).
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
{% for intf in nat_out %}
# NAT exemption (D39): traffic for an address inside the lab is never translated. For a moment
# after a link fails, before OSPF installs the detour, the kernel can send it along the default
# route to the ISP; once translated, every later packet of that connection would keep the wrong
# source (the VPN's own packets included), long after the route is fixed.
{% for net in internal %}
-A POSTROUTING -o {{ intf }} -d {{ net }} -j RETURN
{% endfor %}
# NAT: traffic leaving towards the ISP gets {{ router }}'s address on {{ intf }} as its source,
# so the internet never sees the base's internal addresses.
-A POSTROUTING -o {{ intf }} -j MASQUERADE
{% endfor %}
COMMIT
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
# Zone firewall (T13, decisions D27). Everything {{ router }} routes between zones is dropped
# unless a rule below allows the zone that STARTS the connection ("reach" in fortress.yaml).
# Replies to an allowed connection (and its ICMP errors) come back through conntrack.
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
# Shared service every zone may use: DNS on {{ dns }}.
-A FORWARD -d {{ dns }} -p udp --dport 53 -j ACCEPT
-A FORWARD -d {{ dns }} -p tcp --dport 53 -j ACCEPT
{% if mgmt %}
# SSH to {{ router }} itself only from the Management VLAN (T15).
-A INPUT -p tcp --dport 22 ! -s {{ mgmt }} -j DROP
# Admins on the Management VLAN may SSH to the servers (T15).
-A FORWARD -s {{ mgmt }} -p tcp --dport 22 -j ACCEPT
{% endif %}
# Every lab node may send its logs to the central syslog server {{ syslog }} (T15).
-A FORWARD -d {{ syslog }} -p udp --dport 514 -j ACCEPT
# VPN in transit (D39): the tunnel runs between {{ vpn_ends[0] }} and {{ vpn_ends[1] }} (loopbacks). If the
# primary WAN is cut, its packets detour through this router: let IKE (UDP 500/4500) and ESP pass.
{% for s, d in [(vpn_ends[0], vpn_ends[1]), (vpn_ends[1], vpn_ends[0])] %}
-A FORWARD -s {{ s }} -d {{ d }} -p esp -j ACCEPT
-A FORWARD -s {{ s }} -d {{ d }} -p udp -m multiport --dports 500,4500 -j ACCEPT
{% endfor %}
# The monitoring host may reach everything (and everything may answer it).
-A FORWARD -s {{ monitor }} -j ACCEPT
{% for r in allow %}
# {{ r.comment }}
-A FORWARD -s {{ r.src }} {{ r.dst }} -j ACCEPT
{% endfor %}
COMMIT
