# Copy to .env and fill in. .env is git-ignored: the real token must never be committed.
#
# Telegram alerts (T24). Make a bot by messaging @BotFather on Telegram ("/newbot"); it gives
# you the token. For the chat id, message your new bot once, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and take "chat":{"id":...}. A group works too (its id starts with -100).
FORTRESS_TELEGRAM_TOKEN=
FORTRESS_TELEGRAM_CHAT=

# IPsec pre-shared key (T14). Leave empty and a fresh random key is made at every lab start,
# which is what you want unless you need both ends to keep the same key across restarts.
FORTRESS_VPN_PSK=
